# ==============================================================================
# GoPratle Backend Environment Variables
# ==============================================================================

# Server Port (Render automatically sets process.env.PORT, defaults to 5000 locally)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/gopratle
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/gopratle?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/gopratle?retryWrites=true&w=majority

# Frontend Allowed Origin (for CORS)
# Local: http://localhost:3000
# Production: https://<your-app-name>.vercel.app (or * to allow any during initial test)
FRONTEND_URL=https://<your-app-name>.vercel.app
